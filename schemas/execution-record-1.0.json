                "type": "number"
              },
              "item_height_mm": {
                "exclusiveMinimum": 0,
                "maximum": 2000,
                "type": "number"
              },
              "dpi": {
                "minimum": 72,
                "maximum": 1200,
                "type": "integer"
              },
              "rows": {
                "minimum": 1,
                "maximum": 100,
                "type": "integer"
              },
              "columns": {
                "minimum": 1,
                "maximum": 100,
                "type": "integer"
              },
              "margin_mm": {
                "minimum": 0,
                "maximum": 1000,
                "type": "number"
              },
              "spacing_mm": {
                "minimum": 0,
                "maximum": 1000,
                "type": "number"
              },
              "background": {
                "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$",
                "type": "string"
              }
            }
          }
        ]
      }
    },
    "output": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "width",
        "height",
        "format",
        "channels",
        "has_alpha",
        "bytes",
        "color_space",
        "pages",
        "metadata",
        "hash"
      ],
      "properties": {
        "width": {
          "minimum": 1,
          "maximum": 16384,
          "type": "integer"
        },
        "height": {
          "minimum": 1,
          "maximum": 16384,
          "type": "integer"
        },
        "format": {
          "minLength": 1,
          "type": "string"
        },
        "channels": {
          "minimum": 1,
          "maximum": 16,
          "type": "integer"
        },
        "has_alpha": {
          "type": "boolean"
        },
        "is_opaque": {
          "type": "boolean"
        },
        "bytes": {
          "minimum": 1,
          "type": "integer"
        },
        "orientation": {
          "minimum": 1,
          "maximum": 8,
          "type": "integer"
        },
        "color_space": {
          "minLength": 1,
          "type": "string"
        },
        "pages": {
          "minimum": 1,
          "type": "integer"
        },
        "metadata": {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "icc",
            "exif"
          ],
          "properties": {
            "icc": {
              "type": "boolean"
            },
            "exif": {
              "type": "boolean"
            },
            "density": {
              "exclusiveMinimum": 0,
              "type": "number"
            }
          }
        },
        "hash": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        }
      }
    },
    "timings_ms": {
      "type": "object",
      "patternProperties": {
        "^(.*)$": {
          "minimum": 0,
          "type": "number"
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "state",
          "message"
        ],
        "properties": {
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "state": {
            "anyOf": [
              {
                "const": "pass",
                "type": "string"
              },
              {
                "const": "fail",
                "type": "string"
              },
              {
                "const": "needs_review",
                "type": "string"
              },
              {
                "const": "not_checked",
                "type": "string"
              }
            ]
          },
          "message": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "user_confirmation": {
            "type": "boolean"
          }
        }
      }
    },
    "preset": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "type": "string"
        }
      }
    }
  }
}
